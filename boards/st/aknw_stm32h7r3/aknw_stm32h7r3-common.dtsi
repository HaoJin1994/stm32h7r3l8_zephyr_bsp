/dts-v1/;
#include <st/h7rs/stm32h7r3X8.dtsi>
#include <st/h7/stm32h7r3l8hxh-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
		zephyr,dtcm = &dtcm;
		zephyr,sram = &sram0;
		//zephyr,canbus = &fdcan1;
	};

	leds: leds {
		compatible = "gpio-leds";

		red_led: led_1 {
			gpios = <&gpiod 14 GPIO_ACTIVE_LOW>;
			label = "User LD1";
		};

		green_led: led_2 {
			gpios = <&gpioc 0 GPIO_ACTIVE_LOW>;
			label = "User LD2";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button_0 {
			label = "User";
			gpios = <&gpioc 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &green_led;
		led2 = &red_led;
		sw0 = &user_button;
		watchdog0 = &iwdg;
		spi-flash0 = &w25q128;
		rtc = &rtc;
	};

	ext_memory: memory@90000000 {
		compatible = "zephyr,memory-region";
		reg = <0x90000000 DT_SIZE_M(16)>;
		zephyr,memory-region = "EXTMEM";
		zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_FLASH)>;
	};
};
&sram2 {
	status = "okay";
	zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM_NOCACHE)>;//网络需要，ATTR_MPU_RAM_NOCACHE定义在memory-attr.h中
};


&pwr {
	power-supply = "smps-direct"; //根据原理图接的是smps
};
&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

&pll {
	div-m = <12>;
	mul-n = <250>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	div-s = <2>;
	div-t = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};
/* PLL2 for clocking the xspi peripheral */
&pll2 {
	div-m = <12>;
	mul-n = <200>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	div-s = <2>;
	div-t = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(250)>;
	dcpre = <1>;
	hpre = <1>;
	ppre1 = <2>;
	ppre2 = <2>;
	ppre4 = <2>;
	ppre5 = <2>;
};


&usart1 {
	pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&xspim {
	status = "okay";
};

&xspi1 {
	pinctrl-0 = <&xspim_p1_clk_po4 &xspim_p1_ncs1_po0
		     &xspim_p1_io0_pp0 &xspim_p1_io1_pp1
		     &xspim_p1_io2_pp2 &xspim_p1_io3_pp3
		     &xspim_p1_io4_pp4 &xspim_p1_io5_pp5
		     &xspim_p1_io6_pp6 &xspim_p1_io7_pp7
		     &xspim_p1_dqs0_po2>;
	pinctrl-names = "default";

	status = "okay";

	ext_flash_ctrl:w25q128: xspi-nor-flash@0 {
		compatible = "st,stm32-xspi-nor";
		reg = <0>;
		size = <DT_SIZE_M(128)>; /* 128Mbits */
		ospi-max-frequency = <DT_FREQ_M(20)>;
		spi-bus-width =  <XSPI_QUAD_MODE>;//<XSPI_OCTO_MODE>;
		data-rate = <XSPI_STR_TRANSFER>;
		//four-byte-opcodes;
		jedec-id = [52 21 18];
		writeoc = "PP_1_1_4"; //指令阶段用1线传输，地址阶段用1线传输，数据阶段用4线传输
		status = "okay";

		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x90000000 DT_SIZE_M(16)>;

		ext_flash: nor-flash@0 {
			compatible = "soc-nv-flash";
			status = "okay";
			reg = <0x0 DT_SIZE_M(16)>;
			write-block-size = <1>;
			erase-block-size = <DT_SIZE_K(4)>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
		};
	};
};

zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <&usb_otg_hs_dm_pm5 &usb_otg_hs_dp_pm6>;
	pinctrl-names = "default";
	status = "okay";
};

&usbphyc {
	/*
	 * There is no need to change `clocks` because
	 * we use the default configuration after reset:
	 *  USBPHYC kernel clock = HSE @ 24 MHz
	 */
	status = "okay";
};
