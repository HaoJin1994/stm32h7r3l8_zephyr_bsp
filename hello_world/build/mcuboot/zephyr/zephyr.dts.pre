# 12 "/home/ubuntu/work/aknw_h7rsx/boards/st/aknw_stm32h7r3/aknw_stm32h7r3-common.dtsi" 2

/ {
 chosen {
  zephyr,console = &usart2;
  zephyr,shell-uart = &usart2;
  zephyr,dtcm = &dtcm;
  zephyr,sram = &sram0;

 };

 leds: leds {
  compatible = "gpio-leds";

  red_led: led_1 {
   gpios = <&gpiod 14 (1 << 0)>;
   label = "User LD1";
  };

  green_led: led_2 {
   gpios = <&gpioc 0 (1 << 0)>;
   label = "User LD2";
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button: button_0 {
   label = "User";
   gpios = <&gpioc 13 ((1 << 0) | (1 << 4))>;
   zephyr,code = <11>;
  };
 };

 aliases {
  led0 = &green_led;
  led2 = &red_led;
  sw0 = &user_button;
  watchdog0 = &iwdg;
  spi-flash0 = &w25q128;
  rtc = &rtc;
 };

 ext_memory: memory@90000000 {
  compatible = "zephyr,memory-region";
  reg = <0x90000000 (((16) * 1024) * 1024)>;
  zephyr,memory-region = "EXTMEM";
  zephyr,memory-attr = <(((1UL << (2))) << (20))>;
 };
};
&sram2 {
 status = "okay";
 zephyr,memory-attr = <(((1UL << (1))) << (20))>;
};


&pwr {
 power-supply = "smps-direct";
};
&clk_hsi48 {
 status = "okay";
};

&clk_hse {
 clock-frequency = <(((24) * 1000) * 1000)>;
 status = "okay";
};

&pll {
 div-m = <12>;
 mul-n = <250>;
 div-p = <2>;
 div-q = <2>;
 div-r = <2>;
 div-s = <2>;
 div-t = <2>;
 clocks = <&clk_hse>;
 status = "okay";
};

&pll2 {
 div-m = <12>;
 mul-n = <200>;
 div-p = <2>;
 div-q = <2>;
 div-r = <2>;
 div-s = <2>;
 div-t = <2>;
 clocks = <&clk_hse>;
 status = "okay";
};

&rcc {
 clocks = <&pll>;
 clock-frequency = <(((250) * 1000) * 1000)>;
 dcpre = <1>;
 hpre = <1>;
 ppre1 = <2>;
 ppre2 = <2>;
 ppre4 = <2>;
 ppre5 = <2>;
};


&usart1 {
 pinctrl-0 = <&usart1_tx_pb14 &usart1_rx_pb15>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&usart2 {
 pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&xspim {
 status = "okay";
};

&xspi1 {
 pinctrl-0 = <&xspim_p1_clk_po4 &xspim_p1_ncs1_po0
       &xspim_p1_io0_pp0 &xspim_p1_io1_pp1
       &xspim_p1_io2_pp2 &xspim_p1_io3_pp3
       &xspim_p1_io4_pp4 &xspim_p1_io5_pp5
       &xspim_p1_io6_pp6 &xspim_p1_io7_pp7
       &xspim_p1_dqs0_po2>;
 pinctrl-names = "default";

 status = "okay";

 ext_flash_ctrl:w25q128: xspi-nor-flash@0 {
  compatible = "st,stm32-xspi-nor";
  reg = <0>;
  size = <(((128) * 1024) * 1024)>;
  ospi-max-frequency = <(((20) * 1000) * 1000)>;
  spi-bus-width = <4>;
  data-rate = <1>;

  jedec-id = [52 21 18];
  writeoc = "PP_1_1_4";
  status = "okay";

  #address-cells = <1>;
  #size-cells = <1>;
  ranges = <0x0 0x90000000 (((16) * 1024) * 1024)>;

  ext_flash: nor-flash@0 {
   compatible = "soc-nv-flash";
   status = "okay";
   reg = <0x0 (((16) * 1024) * 1024)>;
   write-block-size = <1>;
   erase-block-size = <((4) * 1024)>;
   #address-cells = <1>;
   #size-cells = <1>;
   ranges;
  };
 };
};

zephyr_udc0: &usbotg_hs {
 pinctrl-0 = <&usb_otg_hs_dm_pm5 &usb_otg_hs_dp_pm6>;
 pinctrl-names = "default";
 status = "okay";
};

&usbphyc {





 status = "okay";
};
# 10 "/home/ubuntu/work/aknw_h7rsx/boards/st/aknw_stm32h7r3/aknw_stm32h7r3_ext_flash_app.dts" 2

/ {
 model = "STMicroelectronics STM32H7R3 board";
 compatible = "st,stm32h7r3";

 chosen {
  zephyr,flash = &ext_flash;
  zephyr,flash-controller = &ext_flash_ctrl;
  zephyr,code-partition = &slot0_partition;

 };

};

&flash0 {
 partitions {
  #address-cells = <1>;
  #size-cells = <1>;
  ranges;

  boot_partition: partition@0 {
   compatible = "zephyr,mapped-partition";
   label = "mcuboot";
   reg = <0x00000000 ((64) * 1024)>;
  };

 };
};

&ext_flash {
 status = "okay";

 partitions {
  #address-cells = <1>;
  #size-cells = <1>;
  ranges;

  slot0_partition: partition@0 {
   compatible = "zephyr,mapped-partition";
   label = "image-0";
   reg = <0x00000000 (((4) * 1024) * 1024)>;
  };

  slot1_partition: partition@800000 {
   compatible = "zephyr,mapped-partition";
   label = "image-1";
   reg = <0x00800000 (((4) * 1024) * 1024)>;
  };

  storage_partition: partition@1000000 {
   compatible = "zephyr,mapped-partition";
   label = "storage";
   reg = <0x01000000 (((8) * 1024) * 1024)>;
  };
 };
};
